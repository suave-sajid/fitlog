# .clineignore — files Cline should skip when auto-loading project context.
# Pattern syntax is identical to .gitignore (# comments, /, **, globs, and ! negations).
# NOTE: this only filters automatic context gathering, it is NOT an access-control
# boundary — files here can still be read if you @-mention them explicitly.
#
# Keep accessible (do NOT add): src/**, public/**, package.json, jsconfig.json,
# next.config.mjs, eslint.config.mjs, postcss.config.mjs, AGENTS.md, CLAUDE.md, README.md

# ── Dependencies ────────────────────────────────────────────────
node_modules/
**/node_modules/
.bun/
.pnp
.pnp.*

# ── Next.js build output & cache ────────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.turbo/
.swc/
.eslintcache

# ── Testing / coverage ──────────────────────────────────────────
coverage/

# ── Lock files (large, machine-generated, no context value) ─────
bun.lock
bun.lockb
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Environment files / secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ── Logs & debug output ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor / deploy noise ──────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.vercel

# ── Git internals ───────────────────────────────────────────────
.git/

# ── Binary assets Cline cannot use as text (comment out if needed) ──
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.woff
*.woff2
*.ttf
*.otf
*.mp4
*.webm
*.pdf
*.zip
*.tar.gz

# ── Large data files ────────────────────────────────────────────
*.csv
*.xlsx
*.sqlite
*.sqlite3
*.parquet

# ── Minified / generated bundles ────────────────────────────────
*.min.js
*.min.css
*.map
